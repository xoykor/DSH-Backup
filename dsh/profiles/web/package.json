{
  "name": "dsh-profile-web",
  "private": true,
  "dependencies": {
    "dsh-context-guard": "file:__DSH_HOME__/plugins/dsh-context-guard",
    "dsh-continue-button": "link:__DSH_HOME__/plugins/dsh-continue-button",
    "dsh-global-token-meter": "link:__DSH_HOME__/plugins/dsh-global-token-meter",
    "dsh-memory": "https://github.com/xoykor/DSH-memory/releases/download/v0.7.1/dsh-memory-0.7.1.tgz",
    "relay-dsh-plugin-codex": "0.2.2"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "relay-dsh-plugin-codex",
        "dsh-context-guard",
        "dsh-continue-button",
        "dsh-global-token-meter",
        "dsh-memory"
      ],
      "patchReload": "live"
    }
  }
}
